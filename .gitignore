# Build artifacts
build/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json

# Грамматики tree-sitter: каталоги — build-входы, а не исходники
# проекта. Версии закреплены в deps/grammars.lock, качать их можно
# самому (`make fetch-grammars`), и в историю они попадать не должны:
# 172 МБ клонов, из которых сборке нужны только src/*.c.
deps/tree-sitter-*-src/

# Runtime data and backups (never commit)
_backups/
_secrets/
backups/
.cache/
.config/
kv_cache/
.mimocode/
bench_results/
/news_rewriter/
# Состояние сессии плагина wp_coder: session_path() строит путь как
# <data_dir>/wp_coder/session.json, а при запуске с data_dir="." (тесты
# хоста, ручной запуск из корня) data_dir — это корень репозитория.
/wp_coder/
profiles/.env
nr_wp_env_test/
**/nr_wp_env_test/
settings.ini
conversation.json
BACKUP_INFO.txt
*.tar.gz
llama-gui-settings-*.json

# Runtime-артефакт панели headless-браузера (пишет сюда скриншоты)
headless_screenshot.png

# Тестовые бинарники, собранные вручную внутрь tests/ (отрицание !tests/**
# выше реинклюдит их вопреки правилу test_*)
tests/test_rag_full_system

