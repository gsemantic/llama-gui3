# Шаблон параметров деплоя nr-seo.php на WordPress-сервер (Timeweb).
# Скопируйте в deploy.env и заполните своими значениями.
# deploy.env НЕ коммитится (.gitignore).

# Хост и порт (FTP/SFTP одного и того же сервера vh442.timeweb.ru)
WP_HOST=vh442.timeweb.ru
WP_PORT=21                 # 21 = ftp; для sftp/ftps — порт от хостера (часто 22)
WP_PROTO=ftp               # ftp | ftps | sftp

# Креды (те же, что для FTP-аккаунта в панели)
WP_USER=ci37993
WP_PASS=ЗАМЕНИТЕ_НА_ПАРОЛЬ_FTP

# Только для WP_PROTO=sftp по ключу (закомментируйте при использовании WP_PASS):
# WP_SSH_KEY=~/.ssh/id_ed25519

# ПОЛНЫЙ путь к папке mu-plugins на сервере. Узнайте в файл-менеджере панели
# или командой `pwd` в SSH-консоли (обычно внутри public_html/wp-content/).
WP_REMOTE_DIR=/home/c/ci37993/public_html/wp-content/mu-plugins
