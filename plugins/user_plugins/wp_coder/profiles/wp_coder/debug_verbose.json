{
  "model": "local",
  "temperature": 0.7,
  "max_tokens": 8192,
  "tools_policy": "verbose",
  "timeout_ms": 300000,
  "allowed_commands": [
    "ls",
    "cat",
    "mkdir",
    "cp",
    "mv",
    "rm",
    "php",
    "wp",
    "git",
    "rsync",
    "npm",
    "composer"
  ],
  "allowed_extensions": [
    ".php",
    ".js",
    ".css",
    ".json",
    ".md",
    ".txt",
    ".yml",
    ".yaml",
    ".log"
  ],
  "rag_enabled": true,
  "description": "Максимальная детализация логов. Для отладки и разработки."
}